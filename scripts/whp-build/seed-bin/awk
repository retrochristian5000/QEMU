#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Literal AWK launcher for QEMU bootstrap; never replace the host's awk.
set -eu

if [ "${1:-}" = --whp-awk-adapter-probe ]; then
    printf '%s\n' 'whp-qemu-awk-seed-adapter'
    exit 0
fi

if [ "${WHP_AWK_LOCKED:-0}" = 1 ]; then
    [ -n "${WHP_AWK_SEED:-}" ] && [ -x "$WHP_AWK_SEED" ] || {
        printf '%s\n' 'error: locked WHP awk has no usable seed' >&2
        exit 1
    }
    case "$WHP_AWK_SEED" in
        */awk.sh|*/scripts/whp-build/seed-bin/awk)
            printf '%s\n' 'error: locked AWK points to the awk bridge' >&2
            exit 1 ;;
    esac
    exec "$WHP_AWK_SEED" "$@"
fi

case "$0" in
    */*) exec "${0%/*}/../../../awk.sh" "$@" ;;
    *) printf '%s\n' 'error: awk bootstrap launcher must be invoked by path' >&2; exit 1 ;;
esac
