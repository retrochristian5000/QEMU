# DejaGNU support for QEMU serial-console tests.

proc qemu_exit {} {}
proc qemu_version {} {}

proc qemu_serial_boot {machine success_pattern} {
    global QEMU
    global QEMU_SERIAL_TIMEOUT
    global spawn_id
    global timeout

    if {![info exists QEMU] || $QEMU eq ""} {
        unsupported "$machine serial console: QEMU is not set"
        return
    }
    if {![file executable $QEMU]} {
        unsupported "$machine serial console: $QEMU is not executable"
        return
    }

    if {![info exists QEMU_SERIAL_TIMEOUT]} {
        set QEMU_SERIAL_TIMEOUT 30
    }
    set timeout $QEMU_SERIAL_TIMEOUT
    set test_name "$machine serial console reaches $success_pattern"

    verbose "spawning $QEMU for $machine serial-console boot test" 1
    spawn -noecho $QEMU \
        -M $machine \
        -accel tcg \
        -display none \
        -monitor none \
        -serial stdio \
        -no-reboot

    set qemu_spawn_id $spawn_id
    set qemu_pid [exp_pid -i $qemu_spawn_id]
    set result fail
    set detail ""

    expect {
        -re $success_pattern {
            set result pass
        }
        -re {Could not load[^\r\n]*} {
            set detail $expect_out(0,string)
        }
        -re {qemu-system-[^:\r\n]+:[^\r\n]*} {
            set detail $expect_out(0,string)
            exp_continue
        }
        eof {
            if {$detail eq ""} {
                set detail "EOF before expected console pattern"
            }
        }
        timeout {
            set detail "timeout after ${timeout}s waiting for console pattern"
        }
    }

    if {$result eq "pass"} {
        pass $test_name
    } else {
        if {$detail eq ""} {
            set detail "console ended without the expected pattern"
        }
        fail "$test_name ($detail)"
    }

    catch {exec kill -TERM $qemu_pid}
    catch {close -i $qemu_spawn_id}
    catch {wait -i $qemu_spawn_id}
}
